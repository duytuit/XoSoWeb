@inject XoSoWeb.Services.SiteSettings Site
@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isVietlottStatisticsPage = Context.Request.Path.StartsWithSegments("/thong-ke/vietlott");
    var isReferencePage = Context.Request.Path.StartsWithSegments("/lich-quay")
        || Context.Request.Path.StartsWithSegments("/co-cau-giai-thuong");
    var isStatisticsPage = isVietlottStatisticsPage
        || IsStatisticsRoute(Context.Request.Path.Value);

    bool IsActive(string controller, string action = null)
    {
        var isControllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        if (action == null)
        {
            return isControllerMatch;
        }

        return isControllerMatch && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }

    bool IsStatisticsRoute(string path)
    {
        return path == "/thong-ke/nhip-so-mien-bac" || path == "/thong-ke/soi-cau" || path == "/thong-ke" || path == "/thong-ke-tan-suat-loto";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <partial name="_Seo" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>

    <!-- TopAppBar -->
    <header id="topbar" class="topbar sticky-top z-3 bg-surface border-bottom border-neutral py-2 w-100">
        <div class="container-xl d-flex justify-content-between align-items-center h-100">
            <button class="mobile-menu-toggle d-lg-none" id="mobile-menu-toggle" type="button"
                    aria-label="Mở menu điều hướng" aria-controls="mobile-navigation" aria-expanded="false">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
            <div class="d-flex align-items-center gap-2">
                <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index" aria-label="Về trang chủ">
                    @if (!string.IsNullOrWhiteSpace(Site.LogoUrl)) { <img src="@Site.LogoUrl" alt="@Site.SiteName" width="168" height="56" class="brand-logo" asp-append-version="true" /> }
                    else { <span class="h5 mb-0 fw-bold text-primary font-headline-md">@Site.SiteName</span> }
                </a>
            </div>
            <nav class="top-navigation d-none d-lg-flex gap-4" aria-label="Điều hướng chính">
                <div class="top-navigation-dropdown">
                    <a class="top-navigation-dropdown-trigger @(IsActive("Home", "Index") || IsActive("Home", "XoSoMienBac") || IsActive("Home", "XoSoMienTrung") || IsActive("Home", "XoSoMienNam") || IsActive("Home", "LotteryArchive") ? "is-active" : "")" href="/">
                        <span>Kết quả</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </a>
                    <div class="top-navigation-submenu">
                        <a href="/">Tổng hợp kết quả</a><a href="/xo-so-mien-bac">Xổ số miền Bắc</a><a href="/xo-so-mien-trung">Xổ số miền Trung</a><a href="/xo-so-mien-nam">Xổ số miền Nam</a>
                    </div>
                </div>
                <a class="@(IsActive("Home", "Vietlott") ? "text-primary border-bottom border-2 border-primary fw-bold" : "text-on-surface-variant fw-medium") text-decoration-none hover-text-primary py-1" asp-controller="Home" asp-action="Vietlott">Vietlott</a>
                <div class="top-navigation-dropdown">
                    <a class="top-navigation-dropdown-trigger @(isStatisticsPage ? "is-active" : "")" href="/thong-ke">
                        <span>Thống kê</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </a>
                    <div class="top-navigation-submenu">
                        <a class="@(IsActive("Home", "Statistics") ? "is-active" : "")" asp-controller="Home" asp-action="Statistics">Giải đặc biệt ba miền</a>
                        <a class="@(IsActive("Home", "NumberRhythm") ? "is-active" : "")" href="/thong-ke/nhip-so-mien-bac">Nhịp số miền Bắc</a>
                        <a class="@(IsActive("Home", "SoiCau") ? "is-active" : "")" href="/thong-ke/soi-cau">Soi cầu miền Bắc</a>
                        <a class="@(IsActive("Home", "LotoFrequency") ? "is-active" : "")" asp-controller="Home" asp-action="LotoFrequency">Tần suất lô tô trong tuần</a>
                        <a class="@(isVietlottStatisticsPage ? "is-active" : "")" href="/thong-ke/vietlott">Thống kê Vietlott</a>
                    </div>
                </div>
                <div class="top-navigation-dropdown">
                    <a class="top-navigation-dropdown-trigger @(isReferencePage ? "is-active" : "")" href="/lich-quay">
                        <span>Lịch quay</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </a>
                    <div class="top-navigation-submenu">
                        <a class="@(Context.Request.Path.StartsWithSegments("/lich-quay") ? "is-active" : "")" href="/lich-quay">Lịch quay</a>
                        <a class="@(Context.Request.Path.StartsWithSegments("/co-cau-giai-thuong") ? "is-active" : "")" href="/co-cau-giai-thuong">Cơ cấu giải thưởng</a>
                    </div>
                </div>
                <div class="top-navigation-dropdown">
                    <a class="top-navigation-dropdown-trigger @(Context.Request.Path.StartsWithSegments("/tin-tuc") ? "is-active" : "")" href="/tin-tuc">
                        <span>Tin tức</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </a>
                    <div class="top-navigation-submenu">
                        <a href="/tin-tuc">Tất cả bài viết</a>
                        <a href="/tin-tuc/vietlott">Tin Vietlott</a>
                        <a href="/tin-tuc/trung-thuong-vietlott">Tin trúng thưởng</a>
                        <a href="/tin-tuc/huong-dan">Hướng dẫn</a>
                    </div>
                </div>
            </nav>
            <button class="btn btn-primary rounded-pill font-label-sm px-4 py-2">
                Đăng nhập
            </button>
        </div>
    </header>

    <div class="mobile-navigation-layer" id="mobile-navigation" hidden>
        <button class="mobile-navigation-backdrop" type="button" data-close-mobile-menu aria-label="Đóng menu"></button>
        <aside class="mobile-navigation-drawer" role="dialog" aria-modal="true" aria-labelledby="mobile-navigation-title">
            <div class="mobile-navigation-header">
                <h2 id="mobile-navigation-title">Danh mục</h2>
                <button class="mobile-navigation-close" type="button" data-close-mobile-menu aria-label="Đóng menu">
                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
            <nav class="mobile-navigation-links" aria-label="Điều hướng chính">
                <a class="mobile-navigation-link @(IsActive("Home", "Index") ? "is-active" : "")" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house" aria-hidden="true"></i><span>Trang chủ</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "XoSoMienBac") ? "is-active" : "")" asp-controller="Home" asp-action="XoSoMienBac">
                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>Xổ số Miền Bắc</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "XoSoMienTrung") ? "is-active" : "")" asp-controller="Home" asp-action="XoSoMienTrung">
                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>Xổ số Miền Trung</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "XoSoMienNam") ? "is-active" : "")" asp-controller="Home" asp-action="XoSoMienNam">
                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i><span>Xổ số Miền Nam</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "Vietlott") ? "is-active" : "")" asp-controller="Home" asp-action="Vietlott">
                    <i class="fa-solid fa-ticket" aria-hidden="true"></i><span>Vietlott</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "Statistics") ? "is-active" : "")" asp-controller="Home" asp-action="Statistics">
                    <i class="fa-solid fa-chart-column" aria-hidden="true"></i><span>Thống kê giải đặc biệt</span>
                </a>
                <a class="mobile-navigation-link @(Context.Request.Path.StartsWithSegments("/thong-ke/vietlott") ? "is-active" : "")" href="/thong-ke/vietlott">
                    <i class="fa-solid fa-chart-column" aria-hidden="true"></i><span>Thống kê Vietlott</span>
                </a>
                <a class="mobile-navigation-link @(Context.Request.Path.StartsWithSegments("/lich-quay") ? "is-active" : "")" href="/lich-quay">
                    <i class="fa-solid fa-calendar-days" aria-hidden="true"></i><span>Lịch quay</span>
                </a>
                <a class="mobile-navigation-link @(Context.Request.Path.StartsWithSegments("/co-cau-giai-thuong") ? "is-active" : "")" href="/co-cau-giai-thuong">
                    <i class="fa-solid fa-list-ol" aria-hidden="true"></i><span>Cơ cấu giải thưởng</span>
                </a>
                <a class="mobile-navigation-link @(Context.Request.Path.StartsWithSegments("/tin-tuc") ? "is-active" : "")" href="/tin-tuc">
                    <i class="fa-solid fa-newspaper" aria-hidden="true"></i><span>Tin tức</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "NumberRhythm") ? "is-active" : "")" href="/thong-ke/nhip-so-mien-bac"><i class="fa-solid fa-table-cells" aria-hidden="true"></i><span>Nhịp số miền Bắc</span></a>
                <a class="mobile-navigation-link @(IsActive("Home", "SoiCau") ? "is-active" : "")" href="/thong-ke/soi-cau"><i class="fa-solid fa-chart-line" aria-hidden="true"></i><span>Soi cầu miền Bắc</span></a>
                <a class="mobile-navigation-link @(IsActive("Home", "LotoFrequency") ? "is-active" : "")" asp-controller="Home" asp-action="LotoFrequency">
                    <i class="fa-solid fa-chart-simple" aria-hidden="true"></i><span>Thống kê tần suất lô tô trong tuần</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "About") ? "is-active" : "")" asp-controller="Home" asp-action="About">
                    <i class="fa-solid fa-bullhorn" aria-hidden="true"></i><span>Liên hệ quảng cáo</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "Support") ? "is-active" : "")" asp-controller="Home" asp-action="Support">
                    <i class="fa-solid fa-headset" aria-hidden="true"></i><span>Hỗ trợ</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "Terms") ? "is-active" : "")" asp-controller="Home" asp-action="Terms">
                    <i class="fa-solid fa-file-lines" aria-hidden="true"></i><span>Điều khoản sử dụng</span>
                </a>
                <a class="mobile-navigation-link @(IsActive("Home", "Privacy") ? "is-active" : "")" asp-controller="Home" asp-action="Privacy">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Chính sách bảo mật</span>
                </a>
            </nav>
        </aside>
    </div>

    <!-- <div class="container-xl mt-2">
        <div class="w-100 bg-surface-container-highest rounded ad-banner" style="height: 96px;">
            Google AdSense - Top Banner
        </div>
    </div> -->

    <main class="container-xl d-flex flex-column flex-lg-row page-content">

        <!-- Sidebar Navigation Drawer (Desktop Only) -->
        <aside class="page-sidebar d-none d-lg-flex flex-column flex-shrink-0 sticky-top" style="top: 80px; height: max-content;">
            <div class="sidebar-region-panel">
                <div class="sidebar-region-heading">
                    <h2 class="font-label-sm text-uppercase opacity-75 mb-0">Khu Vực</h2>
                </div>
                <nav class="sidebar-region-nav">
                    <a class="sidebar-region-link @(IsActive("Home", "XoSoMienBac") ? "is-active" : "")" asp-controller="Home" asp-action="XoSoMienBac">
                        <i class="fa-solid fa-location-dot fs-5" aria-hidden="true"></i>
                        <span>XS Miền Bắc</span>
                    </a>
                    <a class="sidebar-region-link @(IsActive("Home", "XoSoMienTrung") ? "is-active" : "")" asp-controller="Home" asp-action="XoSoMienTrung">
                        <i class="fa-solid fa-location-dot fs-5" aria-hidden="true"></i>
                        <span>XS Miền Trung</span>
                    </a>
                    <a class="sidebar-region-link @(IsActive("Home", "XoSoMienNam") ? "is-active" : "")" asp-controller="Home" asp-action="XoSoMienNam">
                        <i class="fa-solid fa-location-dot fs-5" aria-hidden="true"></i>
                        <span>XS Miền Nam</span>
                    </a>
                </nav>
            </div>
            <div class="sidebar-region-panel mt-2">
                <div class="sidebar-region-heading">
                    <h2 class="font-label-sm text-uppercase opacity-75 mb-0">Thống kê</h2>
                </div>
                <nav class="sidebar-region-nav" aria-label="Menu thống kê">
                    <a class="sidebar-region-link @(IsActive("Home", "Statistics") ? "is-active" : "")" asp-controller="Home" asp-action="Statistics">
                        <i class="fa-solid fa-trophy" aria-hidden="true"></i>
                        <span>Thống kê giải đặc biệt</span>
                    </a>
                    <a class="sidebar-region-link @(IsActive("Home", "NumberRhythm") ? "is-active" : "")" href="/thong-ke/nhip-so-mien-bac"><i class="fa-solid fa-table-cells" aria-hidden="true"></i><span>Nhịp số miền Bắc</span></a>
                <a class="sidebar-region-link @(IsActive("Home", "SoiCau") ? "is-active" : "")" href="/thong-ke/soi-cau"><i class="fa-solid fa-chart-line" aria-hidden="true"></i><span>Soi cầu miền Bắc</span></a>
                <a class="sidebar-region-link @(IsActive("Home", "LotoFrequency") ? "is-active" : "")" asp-controller="Home" asp-action="LotoFrequency">
                        <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
                        <span>Thống kê tần suất lô tô trong tuần</span>
                    </a>
                    <a class="sidebar-region-link @(Context.Request.Path.StartsWithSegments("/thong-ke/vietlott") ? "is-active" : "")" href="/thong-ke/vietlott">
                        <i class="fa-solid fa-chart-column" aria-hidden="true"></i>
                        <span>Thống kê Vietlott</span>
                    </a>
                </nav>
            </div>
        </aside>

        <!-- Main Content Area (render theo từng trang con) -->
        <section class="page-main-column flex-grow-1 d-flex flex-column">
            @if (Context.Request.Path != "/")
            {
                <nav aria-label="Breadcrumb" class="results-breadcrumb">
                    <a href="/">Trang chủ</a>
                    @if (ViewData["BreadcrumbAncestors"] is IEnumerable<XoSoWeb.Services.BreadcrumbLink> breadcrumbAncestors)
                    {
                        foreach (var ancestor in breadcrumbAncestors)
                        {
                            <span aria-hidden="true"> / </span><a href="@ancestor.Path">@ancestor.Label</a>
                        }
                    }
                    else if (ViewData["ParentPath"] is string parentPath
                        && parentPath != "/"
                        && !string.Equals(parentPath, Context.Request.Path.Value, StringComparison.OrdinalIgnoreCase))
                    {
                        <span aria-hidden="true"> / </span><a href="@parentPath">@ViewData["ParentLabel"]</a>
                    }
                    <span aria-hidden="true"> / </span><span aria-current="page">@(ViewData["BreadcrumbCurrentLabel"] ?? ViewData["Title"])</span>
                </nav>
            }
            @RenderBody()
        </section>

    </main>

    <!-- Footer Ad -->
    <!-- <div class="container-xl mb-3 mt-2">
        <div class="w-100 bg-surface-container-highest rounded-4 ad-banner" style="height: 256px;">
            Google AdSense - Large Rectangular Ad
        </div>
    </div> -->

    <!-- Footer -->
    <footer class="bg-inverse-surface text-secondary-container-opacity border-top border-secondary-container-opacity pt-5 pb-3">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between align-items-start gap-4 pb-4 border-bottom border-light border-opacity-10">
            <div class="mb-4 mb-md-0" style="max-width: 350px;">
                <h2 class="h5 fw-bold mb-3"><a class="text-white text-decoration-none @(string.IsNullOrWhiteSpace(Site.LogoUrl) ? "" : "footer-brand")" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrWhiteSpace(Site.LogoUrl)) { <img src="@Site.LogoUrl" alt="@Site.SiteName" width="192" height="64" class="footer-brand-logo" loading="lazy" asp-append-version="true" /> }
                    else { @Site.SiteName }
                </a></h2>
                <p class="text-white-50 mb-3 fs-7">Tra cứu kết quả xổ số ba miền và Vietlott trên giao diện rõ ràng, dễ sử dụng. Chúng tôi liên tục cải thiện tốc độ cập nhật và độ ổn định để bạn thuận tiện theo dõi kết quả mới nhất và tìm lại các kỳ quay trước.</p>
                @if (!string.IsNullOrWhiteSpace(Site.OrganizationName)) { <p>Đơn vị vận hành: @Site.OrganizationName</p> }
            </div>
            <div class="row w-100" style="max-width: 500px;">
                <div class="col-6">
                    <h3 class="font-label-sm text-white text-uppercase mb-3">Thông tin</h3>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a class="text-white-50 text-decoration-none" href="/gioi-thieu">Giới thiệu</a></li>
                        <li><a class="text-white-50 text-decoration-none" href="/nguon-du-lieu">Nguồn dữ liệu và đối soát</a></li>
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="About">Liên hệ quảng cáo</a></li>
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Support">Liên hệ</a></li>
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Terms">Điều khoản sử dụng</a></li>
                    </ul>
                </div>
                <div class="col-6">
                    <h3 class="font-label-sm text-white text-uppercase mb-3">Chính sách</h3>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="container-xl pt-3 text-center">
            <p class="font-label-sm text-white-50 mb-2">@Site.Slogan</p>
            <p class="font-label-sm text-white-50 mb-0 opacity-75">© @XoSoWeb.Services.LotteryUrls.Today.Year @Site.SiteName · Cập nhật kết quả xổ số nhanh chóng — dễ xem, dễ tra cứu mỗi ngày.</p>
        </div>
    </footer>

    <!-- BottomNavBar (Mobile Only) -->
    <nav class="fixed-bottom w-100 z-3 d-flex justify-content-around align-items-center p-2 d-lg-none bg-surface bottom-nav rounded-top-3">
        <a class="d-flex flex-column align-items-center @(IsActive("Home", "XoSoMienBac") ? "text-primary" : "text-on-surface-variant") text-decoration-none" asp-controller="Home" asp-action="XoSoMienBac">
            <i class="fa-solid fa-location-dot mb-1" aria-hidden="true"></i>
            <span class="font-label-sm">Miền Bắc</span>
        </a>
        <a class="d-flex flex-column align-items-center @(IsActive("Home", "XoSoMienTrung") ? "text-primary" : "text-on-surface-variant") text-decoration-none" asp-controller="Home" asp-action="XoSoMienTrung">
            <i class="fa-solid fa-location-dot mb-1" aria-hidden="true"></i>
            <span class="font-label-sm">Miền Trung</span>
        </a>
        <a class="d-flex flex-column align-items-center @(IsActive("Home", "XoSoMienNam") ? "text-primary" : "text-on-surface-variant") text-decoration-none" asp-controller="Home" asp-action="XoSoMienNam">
            <i class="fa-solid fa-location-dot mb-1" aria-hidden="true"></i>
            <span class="font-label-sm">Miền Nam</span>
        </a>
        <a class="d-flex flex-column align-items-center @(IsActive("Home", "Vietlott") ? "text-primary" : "text-on-surface-variant") text-decoration-none" asp-controller="Home" asp-action="Vietlott">
            <i class="fa-solid fa-ticket mb-1" aria-hidden="true"></i>
            <span class="font-label-sm">Vietlott</span>
        </a>
    </nav>


    <!-- Site JS -->
    <script src="~/js/main.js" asp-append-version="true" defer></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
