@{
ViewData["Title"] = "Liên hệ hỗ trợ";
Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">Liên hệ hỗ trợ</h1>
                </div>
            <div class="card-body">
                <p>
                    Nếu bạn gặp sự cố khi sử dụng ứng dụng hoặc cần hỗ trợ,
                    vui lòng gửi thông tin bên dưới. Chúng tôi sẽ phản hồi sớm nhất có thể.
                </p>

                <div id="message"></div>

                <form id="supportForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Họ và tên</label>
                        <input type="text" id="fullName" class="form-control" maxlength="100" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" id="email" class="form-control" maxlength="254" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tiêu đề</label>
                        <input type="text" id="subject" class="form-control" maxlength="200" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nội dung hỗ trợ</label>
                        <textarea id="content" class="form-control" rows="5" maxlength="3000" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Gửi yêu cầu hỗ trợ
                    </button>
                </form>

                <hr />

                <h2 class="h5">Thông tin liên hệ</h2>
                <partial name="_Contact" />
                <p>Khi báo sai kết quả, gửi kèm URL, ngày quay, tỉnh hoặc trò chơi, mã kỳ và thông báo chính thức để đối chiếu.</p>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('supportForm').addEventListener('submit', async function (e) {

    e.preventDefault();
    const submitButton = this.querySelector('button[type="submit"]');
    if (submitButton.disabled) return;
    submitButton.disabled = true;
    submitButton.textContent = 'Đang gửi…';

    const data = {
        fullName: document.getElementById('fullName').value,
        email: document.getElementById('email').value,
        subject: document.getElementById('subject').value,
        content: document.getElementById('content').value
    };
    try {
        const response = await fetch('/support', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': this.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify(data)
        });
        if (response.ok) {
            const result = await response.json();
            document.getElementById('message').innerHTML =
                '<div class="alert alert-success">Yêu cầu hỗ trợ đã được gửi thành công.</div>';
            document.getElementById('supportForm').reset();
        } else {
            document.getElementById('message').innerHTML =
                '<div class="alert alert-danger">Không thể gửi yêu cầu hỗ trợ.</div>';
        }

    } catch {
        document.getElementById('message').innerHTML =
            '<div class="alert alert-danger">Đã xảy ra lỗi hệ thống.</div>';
    } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Gửi yêu cầu hỗ trợ';
    }
});
</script>
