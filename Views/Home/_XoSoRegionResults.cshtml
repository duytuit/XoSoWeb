@inject XoSoWeb.Services.ArchiveCatalog Catalog
@using XoSoWeb.Services
@model XoSoWeb.Models.XoSoRegionViewModel
@using System.Linq

<div class="regional-page-title">
    <div>
        <h1 class="detail-page-heading">Kết quả xổ số @Model.RegionName</h1>
        <p class="detail-page-description">@(Model.SelectedDay.HasValue ? "7 kỳ gần nhất theo thứ được chọn" : "7 ngày có kết quả gần nhất") · Mới nhất ở trên</p>
    </div>
</div>

@{
    var available = await Catalog.GetAsync(Context.RequestAborted);
    if (Model.Results.Count == 0) ViewData["NoIndex"] = true;
}
<nav class="d-flex flex-wrap gap-2" aria-label="Tỉnh và đài có dữ liệu">
@foreach (var province in available.Where(x => x.Region == Model.Region && x.ProvinceCode != null && !x.Date.HasValue))
{ <a href="@province.Path">@province.Label</a> }
</nav>
<nav class="weekday-filter" aria-label="Lọc kết quả theo thứ">
    <a class="@(Model.SelectedDay == null ? "active" : "")" asp-route-day="">@Model.RegionName</a>
    <a class="@(Model.SelectedDay == 1 ? "active" : "")" asp-route-day="1">Thứ 2</a>
    <a class="@(Model.SelectedDay == 2 ? "active" : "")" asp-route-day="2">Thứ 3</a>
    <a class="@(Model.SelectedDay == 3 ? "active" : "")" asp-route-day="3">Thứ 4</a>
    <a class="@(Model.SelectedDay == 4 ? "active" : "")" asp-route-day="4">Thứ 5</a>
    <a class="@(Model.SelectedDay == 5 ? "active" : "")" asp-route-day="5">Thứ 6</a>
    <a class="@(Model.SelectedDay == 6 ? "active" : "")" asp-route-day="6">Thứ 7</a>
    <a class="@(Model.SelectedDay == 7 ? "active" : "")" asp-route-day="7">Chủ Nhật</a>
</nav>

@if (Model.Results.Count == 0)
{
    <div class="results-empty">Không có kết quả @Model.RegionName cho ngày được chọn.</div>
}
else
{
    foreach (var drawDay in Model.Results.GroupBy(result => result.DrawDate.Date).OrderByDescending(group => group.Key))
    {
        var dailyResults = drawDay.OrderBy(result => result.ProvinceName).ToList();
        var dailyModel = new XoSoWeb.Models.XoSoRegionViewModel
        {
            Region = Model.Region,
            IsHistorical = true,
            RegionName = Model.RegionName,
            SelectedDay = Model.SelectedDay,
            Results = dailyResults,
            LotoStatistics = dailyResults.First().LotoStatistics
        };
        <article class="draw-day-card" aria-label="Kết quả ngày @drawDay.Key.ToString("dd/MM/yyyy")">
            <p class="draw-history-link"><a href="@(LotteryUrls.RegionPath(Model.Region) + "/" + drawDay.Key.ToString("dd-MM-yyyy"))">Kết quả cố định ngày @drawDay.Key.ToString("dd/MM/yyyy")</a></p>
            <partial name="_XoSoRegionDayResults" model="dailyModel" />
        </article>
    }
}
