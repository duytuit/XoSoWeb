                        <tr><td class="py-2 fw-bold text-secondary">4</td><td class="py-2 text-center">57</td><td class="py-2 text-end fw-bold">4</td></tr>
                    </tbody>
                </table>
                <div class="mt-auto pt-3">
                    <button class="btn btn-light w-100 border border-neutral text-primary fw-bold">Chi tiết Lô Gan</button>
                </div>
            </div>
        </div>
    </div>
</div>

