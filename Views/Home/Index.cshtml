    <!-- Lotto Head/Tail Statistics -->
    <div class="col-md-4">
        <div class="bg-surface-container-lowest rounded-4 border border-neutral shadow-sm overflow-hidden d-flex flex-column h-100">
            <div class="bg-surface-blue p-3 border-bottom border-neutral">
