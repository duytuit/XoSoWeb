@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Live Results Banner -->
<div class="position-relative overflow-hidden rounded-4 bg-primary-container text-white p-4 p-md-5 shadow-sm border border-primary-subtle">
    <div class="position-absolute top-0 end-0 p-3">
        <div class="d-flex align-items-center gap-2 bg-secondary px-3 py-1 rounded-pill text-white font-label-sm shadow-sm">
            <span class="rounded-circle bg-white red-dot-anim" style="width: 8px; height: 8px;"></span>
            TRỰC TIẾP
        </div>
    </div>
    <div class="d-flex flex-column gap-2 mt-2">
        <h2 class="fs-3 fw-bold mb-0">KQXS Miền Bắc Hôm Nay</h2>
        <p class="opacity-75 mb-0">Thứ Bảy, ngày 01/06/2024</p>
    </div>
    <div class="mt-4 d-flex flex-wrap gap-3">
        <div class="bg-white bg-opacity-10 border border-white border-opacity-25 rounded p-3" style="backdrop-filter: blur(4px); min-width: 120px;">
            <p class="font-label-sm opacity-75 mb-1">Mã đặc biệt</p>
            <p class="fs-5 fw-bold tracking-widest mb-0">1EF - 3EF - 6EF</p>
        </div>
    </div>
</div>

