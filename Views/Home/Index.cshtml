@inject XoSoWeb.Services.SiteSettings Site
@model XoSoWeb.Models.HomePageViewModel
@{
    ViewData["Title"] = "Tổng hợp kết quả xổ số";
    var latestVietlott = Model.Vietlott.Results
        .Where(result => result.GameCode == "MEGA645" || result.GameCode == "POWER655" || result.GameCode == "LOTTO535")
        .ToList();
    var latestMienTrungProvinceCount = Model.MienTrung.Results.Select(r => r.ProvinceCode).Distinct().Count();
    var latestMienNamProvinceCount = Model.MienNam.Results.Select(r => r.ProvinceCode).Distinct().Count();
}

@section Styles { <link rel="stylesheet" href="~/css/news.css" asp-append-version="true" /> }

<div class="results-home-intro">
    <div>
        <span class="font-label-sm text-secondary text-uppercase">Tổng hợp kết quả</span>
        <h1 class="fs-2 fw-bold text-primary mb-1">Kết quả xổ số mới nhất</h1>
        <p class="text-on-surface-variant mb-0">Miền Bắc, Miền Trung, Miền Nam và Vietlott.</p>
    </div>
    <span class="results-status">DỮ LIỆU ĐÃ LƯU</span>
</div>

<p id="live-connection-status" class="small text-secondary" role="status">@(string.IsNullOrWhiteSpace(Site.LiveSocketUrl) ? "Kênh trực tiếp chưa được cấu hình. Dưới đây là dữ liệu đã lưu." : "Đang kết nối kênh trực tiếp…")</p>
<section data-socket-url="@Site.LiveSocketUrl" id="live-results" class="results-section live-results-section" aria-live="polite" hidden>
    <header class="results-section-header">
        <div>
            <h2>Kết quả xổ số trực tiếp</h2>
            <p id="live-results-status">Đang chờ dữ liệu quay số</p>
        </div>
        <span class="results-status"><span class="red-dot-anim"></span> DỮ LIỆU TRỰC TIẾP</span>
    </header>
    <div id="live-results-grid" class="live-results-grid"></div>
</section>

<div class="home-region-summary-grid">
    <section class="home-summary-section">
        <header class="results-section-header">
            <div>
                <h2><a asp-controller="Home" asp-action="XoSoMienBac">Xổ số Miền Bắc</a></h2>
                <p>Kết quả mới nhất</p>
            </div>
            <a class="results-more" asp-controller="Home" asp-action="XoSoMienBac">Chi tiết &#8594;</a>
        </header>
        @if (Model.MienBac.Results.Count == 0)
        {
            <div class="results-empty">Chưa có dữ liệu Miền Bắc.</div>
        }
        else
        {
            var result = Model.MienBac.Results.First();
            <p class="draw-history-link"><a href="@(XoSoWeb.Services.LotteryUrls.RegionPath("MB") + "/" + result.DrawDate.ToString("dd-MM-yyyy"))">Xem kỳ ngày @result.DrawDate.ToString("dd/MM/yyyy")</a></p>
            <div class="home-summary-meta">@result.ProvinceName · @result.DrawDate.ToString("dd/MM/yyyy")</div>
            <table class="home-summary-table">
                <tbody>
                    @foreach (var prize in XoSoPrize.NorthernDisplayPrizes(result.Prizes))
                    {
                        var isSpecial = XoSoPrize.NormalizeName(prize.PrizeName) == "ĐB";
                        <tr class="@(isSpecial ? "special-row" : "") @(XoSoPrize.IsRedPrize(prize.PrizeName, "MB") ? "red-prize-row" : "")">
                            <th>@XoSoPrize.DisplayName(prize.PrizeName)</th>
                            <td><div class="home-prize-numbers @(prize.Numbers.Count == 6 ? "mb-two-row-numbers" : "")">
                                @if (prize.Numbers.Count == 0)
                                {
                                    <small class="text-secondary fw-normal">Chưa cập nhật</small>
                                }
                                @foreach (var number in prize.Numbers)
                                {
                                    <span>@number</span>
                                }
                            </div></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="home-summary-section">
        <header class="results-section-header">
            <div>
                <h2><a asp-controller="Home" asp-action="XoSoMienTrung">Xổ số Miền Trung</a></h2>
                <p>@latestMienTrungProvinceCount tỉnh mới nhất</p>
            </div>
            <a class="results-more" asp-controller="Home" asp-action="XoSoMienTrung">Chi tiết &#8594;</a>
        </header>
        @if (Model.MienTrung.Results.Count == 0)
        {
            <div class="results-empty">Chưa có dữ liệu Miền Trung.</div>
        }
        else
        {
            <p class="draw-history-link"><a href="@("/xo-so-mien-trung/" + Model.MienTrung.Results.First().DrawDate.ToString("dd-MM-yyyy"))">Xem kết quả theo ngày cố định</a></p>
            <div class="home-province-summary-grid">
                @foreach (var result in Model.MienTrung.Results)
                {
                    <div class="home-province-summary">
                        <div class="home-province-summary-heading">
                            <strong>@result.ProvinceName</strong>
                            <small>@result.DrawDate.ToString("dd/MM/yyyy")</small>
                        </div>
                        <div class="home-province-prizes">
                            @foreach (var prize in result.Prizes.OrderByDescending(prize => XoSoPrize.DisplayOrder(prize.PrizeName)))
                            {
                                var isEmphasisPrize = XoSoPrize.IsRedPrize(prize.PrizeName, "MT");
                                <div class="home-province-prize @(isEmphasisPrize ? "emphasis-prize" : "")">
                                    <span>@XoSoPrize.DisplayName(prize.PrizeName)</span>
                                    <div class="home-prize-numbers">
                                        @foreach (var number in prize.Numbers)
                                        {
                                            <b>@number</b>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="home-summary-section">
        <header class="results-section-header">
            <div>
                <h2><a asp-controller="Home" asp-action="XoSoMienNam">Xổ số Miền Nam</a></h2>
                <p>@latestMienNamProvinceCount tỉnh mới nhất</p>
            </div>
            <a class="results-more" asp-controller="Home" asp-action="XoSoMienNam">Chi tiết &#8594;</a>
        </header>
        @if (Model.MienNam.Results.Count == 0)
        {
            <div class="results-empty">Chưa có dữ liệu Miền Nam.</div>
        }
        else
        {
            <p class="draw-history-link"><a href="@("/xo-so-mien-nam/" + Model.MienNam.Results.First().DrawDate.ToString("dd-MM-yyyy"))">Xem kết quả theo ngày cố định</a></p>
            <div class="home-province-summary-grid">
                @foreach (var result in Model.MienNam.Results)
                {
                    <div class="home-province-summary">
                        <div class="home-province-summary-heading">
                            <strong>@result.ProvinceName</strong>
                            <small>@result.DrawDate.ToString("dd/MM/yyyy")</small>
                        </div>
                        <div class="home-province-prizes">
                            @foreach (var prize in result.Prizes.OrderByDescending(prize => XoSoPrize.DisplayOrder(prize.PrizeName)))
                            {
                                var isEmphasisPrize = XoSoPrize.IsRedPrize(prize.PrizeName, "MN");
                                <div class="home-province-prize @(isEmphasisPrize ? "emphasis-prize" : "")">
                                    <span>@XoSoPrize.DisplayName(prize.PrizeName)</span>
                                    <div class="home-prize-numbers">
                                        @foreach (var number in prize.Numbers)
                                        {
                                            <b>@number</b>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<section class="results-section home-vietlott-summary">
    <header class="results-section-header">
        <div>
            <h2><a asp-controller="Home" asp-action="Vietlott">Vietlott</a></h2>
            <p>Các kỳ quay mới nhất</p>
        </div>
        <a class="results-more" asp-controller="Home" asp-action="Vietlott">Chi tiết &#8594;</a>
    </header>
    @if (latestVietlott.Count == 0)
    {
        <div class="results-empty">Chưa có dữ liệu Vietlott.</div>
    }
    else
    {
        <div class="home-vietlott-grid">
            @foreach (var result in latestVietlott)
            {
                <div class="home-vietlott-item">
                    <div><strong>@result.GameCode</strong><small class="text-muted">#@result.DrawNo · @result.DrawDate.ToString("dd/MM/yyyy")</small></div>
                    @if (result.EstimatedPrize.HasValue || result.EstimatedPrize2.HasValue)
                    {
                        <small class="home-vietlott-prize-money">
                            <span>Jackpot ước tính</span>
                            <strong>@(result.EstimatedPrize.HasValue ? $"{result.EstimatedPrize.Value:N0} đ" : "-")</strong>
                            @if (result.EstimatedPrize2.HasValue)
                            {
                                <em>Jackpot 2: @result.EstimatedPrize2.Value.ToString("N0") đ</em>
                            }
                        </small>
                    }
                    <div class="home-vietlott-number-wrap">
                        <div class="home-vietlott-number-line" aria-label="Bộ số Vietlott">
                            <div class="home-vietlott-numbers">
                                @foreach (var number in result.Numbers)
                                {
                                    <span>@number</span>
                                }
                            </div>
                            @if (result.SpecialNumbers.Count > 0)
                            {
                                <span class="home-vietlott-number-separator">|</span>
                                <div class="home-vietlott-special-numbers" aria-label="Số đặc biệt">
                                    @foreach (var number in result.SpecialNumbers)
                                    {
                                        <b class="special-ball">@number</b>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="home-news-section" aria-labelledby="home-news-title">
    <header class="results-section-header">
        <div>
            <h2 id="home-news-title"><a href="/tin-tuc">Tin tức mới</a></h2>
            <p>Tối đa 5 bài viết đã xuất bản</p>
        </div>
        <a class="results-more" href="/tin-tuc">Tất cả tin &#8594;</a>
    </header>
    @if (Model.LatestNews.Count == 0)
    {
        <p class="news-empty">Chưa có bài viết đã xuất bản.</p>
    }
    else
    {
        <div class="news-list news-list-home">
            @foreach (var article in Model.LatestNews)
            {
                <article class="news-list-row">
                    @if (!string.IsNullOrWhiteSpace(article.FeaturedImageUrl))
                    {
                        <a class="news-list-image" href="/tin-tuc/bai-viet/@article.Slug" tabindex="-1" aria-hidden="true">
                            <img src="@(article.ThumbnailImageUrl ?? article.FeaturedImageUrl)" alt="" loading="lazy" />
                        </a>
                    }
                    <div class="news-list-copy">
                        <h3><a href="/tin-tuc/bai-viet/@article.Slug">@article.Title</a></h3>
                        <p class="news-list-meta"><time datetime="@article.PublishedAt.ToString("O")">@XoSoWeb.Services.NewsDateTime.FormatDate(article.PublishedAt)</time></p>
                        @if (!string.IsNullOrWhiteSpace(article.Summary)) { <p class="news-summary">@article.Summary</p> }
                    </div>
                </article>
            }
        </div>
    }
</section>
