                </h3>
            </div>
            <div class="flex-grow-1 p-3 d-flex flex-column">
                <table class="table table-borderless table-sm mb-0 fs-7">
                    <thead>
                        <tr class="text-on-surface-variant border-bottom border-neutral">
                            <th class="pb-2 text-start fw-normal">Đầu</th>
                            <th class="pb-2 text-center fw-normal">Lô tô</th>
                            <th class="pb-2 text-end fw-normal">Đuôi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-bottom border-neutral"><td class="py-2 fw-bold">0</td><td class="py-2 text-center">12, 34</td><td class="py-2 text-end fw-bold text-secondary">0</td></tr>
