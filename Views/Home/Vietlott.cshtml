@model XoSoWeb.Models.VietlottPageViewModel
@{
    ViewData["Title"] = "Kết Quả Vietlott";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h1 class="fs-3 fw-bold text-primary mb-1">Kết quả Vietlott</h1>
        <p class="text-on-surface-variant mb-0">Mega 6/45, Power 6/55 và các sản phẩm Vietlott từ cơ sở dữ liệu.</p>
    </div>
</div>

@if (Model.Results.Count == 0)
{
    <div class="alert alert-light border border-neutral">Chưa có kết quả Vietlott trong cơ sở dữ liệu.</div>
}
else
{
    foreach (var result in Model.Results)
    {
        var currentOffset = Model.SelectedGameCode == result.GameCode ? Model.SelectedOffset : 0;
        var hasPrevious = currentOffset > 0;
        var hasNext = currentOffset + 1 < result.TotalPeriods;
        <section id="vietlott-@result.GameCode" class="bg-surface-container-lowest rounded-4 border border-neutral shadow-sm overflow-hidden mb-4">
            <div class="p-3 bg-surface-container-low border-bottom border-neutral d-flex justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="fs-5 text-primary mb-1">@result.GameCode</h2>
                    <p class="font-label-sm text-on-surface-variant mb-0">Kỳ quay #@result.DrawNo | @result.DrawDate.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="vietlott-period-controls">
                    @if (hasPrevious)
                    {
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Vietlott", "Home", new { gameCode = result.GameCode, offset = currentOffset - 1 })#vietlott-@result.GameCode" title="Kỳ trước">&#8592; Kỳ trước</a>
                    }
                    @if (hasNext)
                    {
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Vietlott", "Home", new { gameCode = result.GameCode, offset = currentOffset + 1 })#vietlott-@result.GameCode" title="Kỳ sau">Kỳ sau &#8594;</a>
                    }
                </div>
            </div>
            <div class="p-4">
                @if (result.Numbers.Count > 0)
                {
                    <div class="d-flex justify-content-center flex-wrap gap-2 mb-3">
                        @foreach (var number in result.Numbers)
                        {
                            <span class="lottery-ball lottery-ball-sm vietlott-red-gradient text-white font-number-display">@number</span>
                        }
                        @foreach (var number in result.SpecialNumbers)
                        {
                            <span class="lottery-ball lottery-ball-sm bg-accent text-primary font-number-display border border-2 border-primary border-opacity-25">@number</span>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(result.OddEven) || !string.IsNullOrWhiteSpace(result.Size))
                {
                    <p class="text-center text-on-surface-variant mb-3">
                        @if (!string.IsNullOrWhiteSpace(result.OddEven)) { <span>@result.OddEven</span> }
                        @if (!string.IsNullOrWhiteSpace(result.OddEven) && !string.IsNullOrWhiteSpace(result.Size)) { <span> | </span> }
                        @if (!string.IsNullOrWhiteSpace(result.Size)) { <span>@result.Size</span> }
                    </p>
                }
                @if (result.Prizes.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr class="text-on-surface-variant">
                                    <th>Giải thưởng</th>
                                    <th>Kết quả</th>
                                    <th class="text-end">Giá trị</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prize in result.Prizes)
                                {
                                    <tr>
                                        <td class="fw-bold">@prize.PrizeName</td>
                                        <td>@string.Join(", ", prize.Numbers)</td>
                                        <td class="text-end">@(prize.Value ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.location.hash) {
                var target = document.querySelector(window.location.hash);
                if (target) {
                    window.setTimeout(function () {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 50);
                }
            }
        });
    </script>
}
