@model XoSoWeb.Models.SoiCauViewModel
@using System.Linq
@using XoSoWeb.Services
@{
    ViewData["Title"] = "Soi cầu miền Bắc";
    ViewData["Description"] = "Tra cứu cầu theo vị trí chữ số, độ dài và lịch sử đối chiếu kết quả miền Bắc.";
    ViewData["ParentPath"] = "/thong-ke";
    ViewData["ParentLabel"] = "Thống kê";
    if (Model.Draws.Count < 2) ViewData["NoIndex"] = true;
    var latest = Model.Draws.FirstOrDefault(d => d.Date == Model.Date.AddDays(-1));
    var positions = Model.Patterns.SelectMany(p => new[] { p.First, p.Second }).ToHashSet();
    var groups = Model.Patterns.GroupBy(p => Model.Reverse && string.CompareOrdinal(p.Number, new string(p.Number.Reverse().ToArray())) > 0 ? new string(p.Number.Reverse().ToArray()) : p.Number).OrderByDescending(g => g.Count()).ThenBy(g => g.Key).ToList();
}
@section Styles {
    <link rel="stylesheet" href="~/css/soi-cau.css" asp-append-version="true" />
}
<div class="regional-page-title"><div><h1 class="detail-page-heading">Soi cầu miền Bắc</h1><p class="detail-page-description">Phân tích các cặp vị trí chữ số từ kết quả đã lưu.</p></div></div>
<div class="soicau-page" data-target="@Model.Target">
<form method="get" action="/thong-ke/soi-cau" class="sc-filter">
    <label>Ngày soi cầu<input class="form-control" type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" min="1753-02-01" max="@LotteryUrls.Today.ToString("yyyy-MM-dd")" required /></label>
    <label>Độ dài tối thiểu<select class="form-select" name="length">@for (var i = 1; i <= 10; i++) { <option value="@i" selected="@(Model.Length == i)">@i ngày</option> }</select></label>
    <label>Loại cầu<select class="form-select" name="target"><option value="loto" selected="@(Model.Target == "loto")">Lô tô (tất cả giải)</option><option value="special" selected="@(Model.Target == "special")">Hai số cuối đặc biệt</option></select></label>
    <label>Số đảo<select class="form-select" name="reverse"><option value="true" selected="@Model.Reverse">Có tính số đảo</option><option value="false" selected="@(!Model.Reverse)">Không tính số đảo</option></select></label>
    <label>Tìm cặp số<input class="form-control" type="text" name="q" value="@Model.Q" inputmode="numeric" pattern="[0-9]{2}" maxlength="2" placeholder="00–99" /></label>
    <button class="btn btn-primary" type="submit">Soi cầu</button>
</form>
<p class="sc-note">Mỗi cầu ghép hai vị trí khác nhau trong bảng giải ngày trước, rồi đối chiếu hai số cuối ở ngày kế tiếp. Chỉ dùng dữ liệu trước @Model.Date.ToString("dd/MM/yyyy"), tối đa 30 ngày đối chiếu liên tiếp; dừng khi thiếu dữ liệu hoặc cầu không khớp. Kết quả lịch sử không bảo đảm kết quả tương lai.</p>
@if (latest == null) {
    <div class="sc-card"><p>Chưa có bảng kết quả miền Bắc đầy đủ ngày @Model.Date.AddDays(-1).ToString("dd/MM/yyyy") để soi cầu. Vui lòng chọn ngày khác.</p></div>
} else {
    <section class="sc-card"><h2>Bảng vị trí ngày @latest.Date.ToString("dd/MM/yyyy")</h2><p>Chọn chữ số được tô đậm để lọc các cầu có vị trí đó. Chọn lại để bỏ lọc.</p>
    <div class="sc-matrix">@for (var i = 0; i < latest.Digits.Length; i++) {
        <button type="button" class="sc-digit @(positions.Contains(i) ? "has-pattern" : "")" data-position="@i" title="@latest.Labels[i]" aria-label="@latest.Labels[i]: @latest.Digits[i]" aria-pressed="false" disabled="@(!positions.Contains(i))">@latest.Digits[i]<small>@(i + 1)</small></button>
    }</div><p id="sc-position-status" aria-live="polite"></p></section>
    <section class="sc-card"><h2>Cầu lặp theo cặp số</h2><p><strong>@Model.Patterns.Count cầu</strong> đạt từ @Model.Length ngày, thuộc @groups.Count cặp số.</p>
    <div class="sc-groups">@foreach (var group in groups) {
        var reversed = new string(group.Key.Reverse().ToArray());
        <a href="#sc-results" class="sc-group" data-number="@group.Key"><strong>@group.Key@(Model.Reverse && reversed != group.Key ? "/" + reversed : "")</strong><span>@group.Count() cầu</span></a>
    }</div></section>
    <section class="sc-card" id="sc-results"><h2>Kết quả soi cầu ngày @Model.Date.ToString("dd/MM/yyyy")</h2>
    <button type="button" id="sc-reset" class="btn btn-outline-secondary btn-sm">Hiện tất cả cầu</button>
    @if (Model.Patterns.Count == 0) { <p>Không tìm thấy cầu đạt điều kiện. Có thể giảm độ dài hoặc chọn ngày khác. Cần ít nhất @(Model.Length + 1) bảng kết quả đầy đủ, liên tiếp.</p> }
    <div class="sc-patterns">@foreach (var pattern in Model.Patterns) {
        <details class="sc-pattern" data-first="@pattern.First" data-second="@pattern.Second" data-value="@pattern.Number" data-reversed="@(new string(pattern.Number.Reverse().ToArray()))">
            <summary><strong>@pattern.Number</strong><span>@pattern.Steps.Count ngày</span><span>Vị trí @(pattern.First + 1) + @(pattern.Second + 1)</span></summary>
            <p>@latest.Labels[pattern.First] + @latest.Labels[pattern.Second]</p>
            <p>Ghép ngày @latest.Date.ToString("dd/MM/yyyy"): <strong>@pattern.Number</strong> → ngày @Model.Date.ToString("dd/MM/yyyy") (chưa đối chiếu).</p>
            <p class="sc-board-legend"><span class="sc-source-key">Chữ số tạo cầu</span><span class="sc-hit-key">Hai số cuối đã về</span></p>
            <div class="sc-history-boards" data-first="@pattern.First" data-second="@pattern.Second" data-dates="@string.Join(",", pattern.Steps.Select(step => step.SourceDate.ToString("yyyy-MM-dd")).Prepend(latest.Date.ToString("yyyy-MM-dd")))" data-hits="@string.Join(",", pattern.Steps.Select(step => step.Matched).Append(""))"></div>
            <div class="sc-table-wrap"><table class="table"><thead><tr><th>Ngày lấy vị trí</th><th>Số ghép</th><th>Ngày đối chiếu</th><th>Số đã về</th></tr></thead><tbody>@foreach (var step in pattern.Steps) { <tr><td>@step.SourceDate.ToString("dd/MM/yyyy")</td><td>@step.Number</td><td>@step.ResultDate.ToString("dd/MM/yyyy")</td><td>@step.Matched</td></tr> }</tbody></table></div>
        </details>
    }</div><p id="sc-empty" hidden>Không có cầu phù hợp với bộ lọc đang chọn.</p></section>
}
@foreach (var draw in Model.Draws) {
    <template id="sc-draw-@draw.Date.ToString("yyyy-MM-dd")"><partial name="_SoiCauBoard" model="@(new XoSoWeb.Models.SoiCauBoardViewModel { Draw = draw })" /></template>
}
</div>
@section Scripts { <script src="~/js/soi-cau.js" asp-append-version="true"></script> }
