@model XoSoWeb.Models.ArchivePage
@using XoSoWeb.Services
<h1 class="detail-page-heading">@Model.Title</h1>
<p><a href="@Model.ParentPath">@Model.ParentLabel</a></p>
@if (Model.Regional != null)
{
    var regionSlug = Model.Regional.Region == "MB" ? "mien-bac" : Model.Regional.Region == "MT" ? "mien-trung" : "mien-nam";
    var stationNames = Model.Regional.Results.Select(result => result.ProvinceName).Where(name => !string.IsNullOrWhiteSpace(name)).Distinct().ToList();
    var isRegionalArchive = Context.Request.Path.Value.StartsWith(LotteryUrls.RegionPath(Model.Regional.Region), StringComparison.OrdinalIgnoreCase);
    var stationName = !isRegionalArchive && stationNames.Count == 1 ? stationNames[0] : null;
    <nav class="d-flex flex-wrap gap-2 mb-2" aria-label="Lịch quay và cơ cấu giải">
        <a href="/lich-quay/@regionSlug@(stationName != null ? "?station=" + Uri.EscapeDataString(stationName) : "")">Lịch quay @(stationName ?? Model.Regional.RegionName)</a>
        <a href="/co-cau-giai-thuong/@regionSlug">Cơ cấu giải @Model.Regional.RegionName</a>
    </nav>
    foreach (var day in Model.Regional.Results.GroupBy(x => x.DrawDate.Date).OrderByDescending(x => x.Key))
    {
        var daily = new XoSoWeb.Models.XoSoRegionViewModel { Region = Model.Regional.Region, RegionName = Model.Regional.RegionName, IsHistorical = true,
            Results = day.ToList(), LotoStatistics = day.First().LotoStatistics };
        <partial name="_XoSoRegionDayResults" model="daily" />
    }
}
@if (Model.Vietlott != null)
{
    foreach (var result in Model.Vietlott.Results)
    {
        <nav class="d-flex flex-wrap gap-2 mb-2" aria-label="Thông tin trò chơi Vietlott">
            <a href="/lich-quay/vietlott?game=@LotteryUrls.Slug(result.GameCode)">Lịch quay @LotteryUrls.GameName(result.GameCode)</a>
            <a href="/co-cau-giai-thuong/vietlott/@LotteryUrls.Slug(result.GameCode)">Cơ cấu giải @LotteryUrls.GameName(result.GameCode)</a>
        </nav>
        <section class="card card-body">
            <h2>@LotteryUrls.GameName(result.GameCode) · Kỳ @result.DrawNo</h2>
            <p>Ngày quay: <time datetime="@result.DrawDate.ToString("yyyy-MM-dd")">@result.DrawDate.ToString("dd/MM/yyyy")</time></p>
            <div class="d-flex flex-wrap gap-2">@foreach (var number in result.Numbers) { <strong>@number</strong> }
                @foreach (var number in result.SpecialNumbers) { <strong class="text-primary">@number</strong> }</div>
            @if (result.Total.HasValue || !string.IsNullOrWhiteSpace(result.OddEven) || !string.IsNullOrWhiteSpace(result.Size))
            {
                <dl class="d-flex flex-wrap gap-3">
                    @if (result.Total.HasValue) { <div><dt>Tổng</dt><dd>@result.Total</dd></div> }
                    @if (!string.IsNullOrWhiteSpace(result.OddEven)) { <div><dt>Chẵn/lẻ</dt><dd>@result.OddEven</dd></div> }
                    @if (!string.IsNullOrWhiteSpace(result.Size)) { <div><dt>Lớn/hòa/nhỏ</dt><dd>@result.Size</dd></div> }
                </dl>
            }
            @if (result.Prizes.Count > 0)
            {
                <div class="lottery-table-wrap"><table class="table"><thead><tr><th>Giải</th><th>Kết quả</th><th>Giá trị</th></tr></thead><tbody>
                @foreach (var prize in result.Prizes) { <tr><th>@prize.PrizeName</th><td>@string.Join(" · ", prize.Numbers)</td><td>@prize.Value</td></tr> }
                </tbody></table></div>
            }
        </section>
    }
}
<nav class="d-flex justify-content-between gap-3" aria-label="Kỳ liền kề">
    @if (Model.Previous != null) { <a href="@Model.Previous.Path">← Kỳ trước: @Model.Previous.Label</a> }
    @if (Model.Next != null) { <a href="@Model.Next.Path">Kỳ tiếp theo: @Model.Next.Label →</a> }
</nav>
<h2>Lịch sử có dữ liệu</h2>
<ul>@foreach (var link in Model.Links) { <li><a href="@link.Path">@link.Label</a></li> }</ul>
