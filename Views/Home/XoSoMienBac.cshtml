@model XoSoWeb.Models.XoSoRegionViewModel
@{
    if (!Model.Results.Any(r => XoSoWeb.Services.LotteryDataQuality.IsComplete(r.Prizes, Model.Region))) ViewData["NoIndex"] = true;
    ViewData["Title"] = "XSMB - Kết quả xổ số miền Bắc mới nhất";
    if (Model.SelectedDay.HasValue)
    {
        var weekday = Model.SelectedDay == 7 ? "Chủ nhật" : "Thứ " + (Model.SelectedDay + 1);
        ViewData["Title"] += " · " + weekday;
        ViewData["Description"] = "Kết quả xổ số " + Model.RegionName + " vào " + weekday + ", gồm bảng giải và liên kết đến từng ngày quay đã lưu.";
    }
}

<partial name="_XoSoRegionResults" model="Model" />
